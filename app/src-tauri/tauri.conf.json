{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holos Studio",
  "version": "0.2.0",
  "identifier": "com.brainfromukraine.holos",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Holos Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#0a0b0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Brain From Ukraine",
    "copyright": "© 2026 Brain From Ukraine. MIT License.",
    "homepage": "https://github.com/BrainFromUkraine/holos-studio",
    "category": "AudioVideo",
    "shortDescription": "Podcast editor",
    "longDescription": "Desktop podcast editor with transcript-based editing, professional voice processing, and AI control via MCP.",
    "resources": {
      "resources/engine": "engine",
      "resources/bin": "bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Ukrainian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCODFFQjZGQTJCMjIzQjgKUldTNEk3S2liK3VCS3oyeHI1akJGWDJqeko5b242d01mbkMvWXNOWWNTVkYweWdOZURTb2hSRk0K",
      "endpoints": [
        "https://github.com/BrainFromUkraine/holos-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
